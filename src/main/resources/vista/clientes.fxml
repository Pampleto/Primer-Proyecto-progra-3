<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0"
      styleClass="vista"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controlador.ClienteController">

    <stylesheets>
        <URL value="@../css/estilos.css"/>
    </stylesheets>

    <!-- TITULO -->
    <Label styleClass="titulo-vista"
           text="Registro de Clientes"/>

    <!-- FORMULARIO -->
    <GridPane hgap="12.0"
              vgap="12.0"
              styleClass="formulario">

        <columnConstraints>
            <ColumnConstraints hgrow="NEVER"
                               minWidth="100.0"/>

            <ColumnConstraints hgrow="ALWAYS"
                               maxWidth="320.0"
                               minWidth="220.0"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>

        <Label text="Nombre:"/>

        <TextField fx:id="campoNombre"
                   promptText="Nombre completo del cliente"
                   GridPane.columnIndex="1"/>

        <Label text="Edad:"
               GridPane.rowIndex="1"/>

        <TextField fx:id="campoEdad"
                   promptText="Edad del cliente"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <padding>
            <Insets bottom="16.0"
                    left="16.0"
                    right="16.0"
                    top="16.0"/>
        </padding>

    </GridPane>

    <!-- ACCIONES DEL CRUD -->
    <VBox spacing="12.0">

        <!-- Primera fila: registrar, modificar, eliminar -->
        <HBox alignment="CENTER_LEFT"
              spacing="12.0">

            <Button onAction="#registrarCliente"
                    styleClass="boton-primario"
                    prefWidth="190.0"
                    text="Registrar Cliente"/>

            <Button onAction="#modificarCliente"
                    styleClass="boton-primario"
                    prefWidth="190.0"
                    text="Modificar Cliente"/>

            <Button onAction="#eliminarCliente"
                    styleClass="boton-primario"
                    prefWidth="190.0"
                    text="Eliminar Cliente"/>

        </HBox>

        <!-- Segunda fila: busqueda -->
        <HBox alignment="CENTER_LEFT"
              spacing="12.0">

            <Label text="Buscar por ID:"/>

            <TextField fx:id="campoBuscarId"
                       promptText="ID del cliente"
                       prefWidth="150.0"/>

            <Button onAction="#buscarCliente"
                    styleClass="boton-primario"
                    prefWidth="170.0"
                    text="Buscar Cliente"/>

        </HBox>

        <!-- Mensajes del sistema -->
        <Label fx:id="mensajeEstado"
               styleClass="mensaje-estado"
               wrapText="true"
               text=""/>

    </VBox>

    <!-- TABLA DE CLIENTES -->
    <TableView fx:id="tablaClientes"
               styleClass="tabla"
               VBox.vgrow="ALWAYS">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <columns>

            <TableColumn fx:id="columnaId"
                         prefWidth="80.0"
                         text="ID"/>

            <TableColumn fx:id="columnaNombre"
                         prefWidth="320.0"
                         text="Nombre"/>

            <TableColumn fx:id="columnaEdad"
                         prefWidth="120.0"
                         text="Edad"/>

        </columns>

    </TableView>

    <padding>
        <Insets bottom="24.0"
                left="24.0"
                right="24.0"
                top="24.0"/>
    </padding>

</VBox>
