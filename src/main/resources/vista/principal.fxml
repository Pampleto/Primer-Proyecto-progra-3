<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" styleClass="fondo-principal" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.PrincipalController">
    <stylesheets>
        <URL value="@../css/estilos.css"/>
    </stylesheets>
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="72.0" styleClass="barra-superior" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="titulo-aplicacion" text="TravelSafe"/>
                <Label styleClass="subtitulo-aplicacion" text="Cotizador de Seguros de Viaje"/>
            </children>
            <padding>
                <Insets left="24.0" right="24.0"/>
            </padding>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="menu-lateral" BorderPane.alignment="CENTER">
            <children>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarClientes" styleClass="boton-menu" text="Clientes"/>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarCotizador" styleClass="boton-menu" text="Cotizar"/>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarHistorial" styleClass="boton-menu" text="Historial"/>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenidoCentral" styleClass="panel-contenido" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="texto-bienvenida" text="Bienvenido a TravelSafe"/>
            </children>
        </StackPane>
    </center>
</BorderPane>