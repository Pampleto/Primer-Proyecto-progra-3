<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0"
      styleClass="vista"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controlador.EstadisticasController">

    <stylesheets>
        <URL value="@../css/estilos.css"/>
    </stylesheets>

    <children>

        <Label
                styleClass="titulo-vista"
                text="Estadísticas de Cotizaciones"/>

        <!-- RESUMEN PRINCIPAL -->
        <HBox alignment="CENTER_LEFT"
              spacing="24.0"
              styleClass="contenedor-tarjetas">
            <children>
                <VBox maxWidth="320.0" spacing="8.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="tarjeta-detalle" text="Total de contrataciones"/>
                        <Label fx:id="totalCotizaciones" styleClass="tarjeta-precio" text="0"/>
                    </children>
                </VBox>
                <VBox maxWidth="320.0" spacing="8.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="tarjeta-detalle" text="Monto acumulado (₡)"/>
                        <Label fx:id="sumaPrecios" styleClass="tarjeta-precio" text="₡ 0.00"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- DESGLOSE POR PLAN -->
        <VBox spacing="8.0"
              styleClass="formulario">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Desglose por plan"/>
                <VBox fx:id="contenedorDesglose" spacing="6.0">
                    <children>
                        <Label text="Cargando..."/>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- MENSAJES Y ACCIONES -->
        <Label fx:id="mensajeEstadisticas"
               styleClass="mensaje-estado"
               text=""
               wrapText="true"/>

        <Button mnemonicParsing="false"
                onAction="#actualizarEstadisticas"
                styleClass="boton-primario"
                text="Actualizar estadísticas"
                maxWidth="220.0"/>

    </children>

    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

</VBox>
