<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0"
      styleClass="vista"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controlador.HistorialController">

    <stylesheets>
        <URL value="@../css/estilos.css"/>
    </stylesheets>

    <children>

        <Label
                styleClass="titulo-vista"
                text="Historial de Cotizaciones"/>

        <HBox alignment="CENTER_LEFT"
              spacing="12.0"
              styleClass="formulario">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <children>
                <Label text="Filtrar por:" styleClass="etiqueta-filtro"/>
                <TextField
                        fx:id="campoIdCliente"
                        promptText="ID de cliente"
                        prefWidth="120.0"/>
                <ComboBox
                        fx:id="comboTipoDestino"
                        promptText="Destino (cualquiera)"
                        prefWidth="170.0"/>
                <DatePicker
                        fx:id="fechaDesde"
                        promptText="Desde"/>
                <DatePicker
                        fx:id="fechaHasta"
                        promptText="Hasta"/>
                <HBox spacing="8.0">
                    <Button
                            mnemonicParsing="false"
                            onAction="#buscar"
                            styleClass="boton-primario"
                            text="Buscar"/>
                    <Button
                            mnemonicParsing="false"
                            onAction="#limpiarFiltros"
                            styleClass="boton-secundario"
                            text="Limpiar"/>
                </HBox>
            </children>
        </HBox>

        <Label
                fx:id="mensajeHistorial"
                styleClass="mensaje-estado"
                text="Aun no hay cotizaciones contratadas."
                wrapText="true"/>

        <TableView
                fx:id="tablaCotizaciones"
                VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn
                        fx:id="columnaId"
                        prefWidth="70.0"
                        text="ID"/>

                <TableColumn
                        fx:id="columnaCliente"
                        prefWidth="180.0"
                        text="Cliente"/>

                <TableColumn
                        fx:id="columnaDestino"
                        prefWidth="150.0"
                        text="Destino"/>

                <TableColumn
                        fx:id="columnaDias"
                        prefWidth="100.0"
                        text="D\u00EDas"/>

                <TableColumn
                        fx:id="columnaPlan"
                        prefWidth="190.0"
                        text="Plan"/>

                <TableColumn
                        fx:id="columnaPrecio"
                        prefWidth="150.0"
                        text="Precio Final"/>

            </columns>

        </TableView>

    </children>

    <padding>
        <Insets
                bottom="24.0"
                left="24.0"
                right="24.0"
                top="24.0"/>
    </padding>

</VBox>