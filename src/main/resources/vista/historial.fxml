<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="vista" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.HistorialController">
    <stylesheets>
        <URL value="@../css/estilos.css"/>
    </stylesheets>
    <children>
        <Label styleClass="titulo-vista" text="Historial de Cotizaciones"/>
        <Label styleClass="texto-placeholder" text="Aún no hay cotizaciones registradas."/>
        <Label fx:id="mensajeHistorial" styleClass="mensaje-estado" text="Las cotizaciones que se contraten aparecerán aquí en la siguiente fase del proyecto." wrapText="true"/>
    </children>
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>
</VBox>